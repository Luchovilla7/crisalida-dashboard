# Supabase (Project Settings -> API). NUNCA uses NEXT_PUBLIC_ para estas: se usan solo del lado del servidor.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Contraseña compartida para entrar al dashboard: cada persona del equipo (config/agency.ts
# -> team, campo "email") entra con su propio email pero con esta misma contraseña.
DASHBOARD_PASSWORD=cambiame
# Cadena secreta larga y aleatoria, usada para firmar la cookie de sesion. Generala una vez y no la cambies (o se cerraria la sesion de todos).
SESSION_SECRET=cambiame-por-un-string-largo-y-random
